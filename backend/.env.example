# Copy to .env and adjust. Never commit .env.
SECRET_KEY=change-me-with-a-long-random-string
DEBUG=True
# Add your LAN IP (e.g. 192.168.1.20) to test with Expo Go on a phone.
ALLOWED_HOSTS=localhost,127.0.0.1
# Expo web dev server origin(s).
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Leave empty for SQLite. Production: postgres://user:password@host:5432/mymarathon
DATABASE_URL=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30
# Production only (DEBUG=False): HTTPS redirect is on by default; enable HSTS once HTTPS is final.
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
