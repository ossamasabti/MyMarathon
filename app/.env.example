# Copy to .env. Variables prefixed with EXPO_PUBLIC_ are embedded in the app bundle: never put secrets here.
# Web / iOS simulator: http://localhost:8000
# Android emulator: http://10.0.2.2:8000
# Phone with Expo Go: http://<LAN IP of your PC>:8000 (also add it to ALLOWED_HOSTS in backend/.env)
EXPO_PUBLIC_API_URL=http://localhost:8000
